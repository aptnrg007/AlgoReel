{
  "name": "algoreel-mcp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "render:binary-search": "remotion render remotion/index.ts BinarySearch out/binary-search.mp4",
    "render:bubble-sort": "remotion render remotion/index.ts BubbleSort out/bubble-sort.mp4",
    "render:bfs": "remotion render remotion/index.ts Bfs out/bfs.mp4",
    "render:reverse-linked-list": "remotion render remotion/index.ts ReverseLinkedList out/reverse-linked-list.mp4",
    "render:inorder-traversal": "remotion render remotion/index.ts InorderTraversal out/inorder-traversal.mp4",
    "render:balanced-parens": "remotion render remotion/index.ts BalancedParens out/balanced-parens.mp4",
    "render:bst-insert": "remotion render remotion/index.ts BstInsert out/bst-insert.mp4",
    "render:time-series-demo": "remotion render remotion/index.ts TimeSeriesDemo out/time-series-demo.mp4",
    "render:time-series-cli": "tsx src/cli/renderTimeSeries.ts specs/time-series/time-series-demo.json --duration=20",
    "render:bar-race-demo": "remotion render remotion/index.ts BarRaceDemo out/bar-race-demo.mp4",
    "render:bar-race-cli": "tsx src/cli/renderBarRace.ts specs/bar-race/bar-race-demo.json --duration=20",
    "generate:schema": "tsx scripts/generate-story-spec-schema.ts",
    "studio": "remotion studio remotion/index.ts",
    "test": "node --import tsx --test --test-concurrency=1 $(find src remotion -name '*.test.ts' | sort)"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@remotion/bundler": "^4.0.286",
    "@remotion/cli": "^4.0.286",
    "@remotion/renderer": "^4.0.286",
    "esbuild": "^0.28.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.286",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3"
  }
}
