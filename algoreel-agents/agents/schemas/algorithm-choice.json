  "type": "object",
  "properties": {
    "algorithm": {
      "type": "string",
      "minLength": 1
    },
    "structure": {
      "type": "string",
      "enum": [
        "array",
        "graph",
        "tree",
        "other"
      ]
    }
  },
  "required": [
