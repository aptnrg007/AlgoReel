{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "videoType": { "type": "string", "enum": ["time_series", "bar_race"] },
    "xColumn": { "type": "string" },
    "yColumns": { "type": "array", "items": { "type": "string" } },
    "entityColumn": { "type": "string" },
    "periodColumn": { "type": "string" },
    "valueColumn": { "type": "string" },
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "column": { "type": "string" },
          "value": { "type": "string" }
        },
        "required": ["column", "value"],
        "additionalProperties": false
      }
    },
    "range": {
      "type": "object",
      "properties": {
        "column": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" }
      },
      "required": ["column"],
      "additionalProperties": false
    },
    "topN": { "type": "integer" }
  },
  "required": ["videoType"],
  "additionalProperties": false
}
