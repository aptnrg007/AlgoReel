{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "hook": {
      "type": "string",
      "minLength": 1
    },
    "opTexts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outroText": {
      "type": "string",
      "minLength": 1
    },
    "complexity": {
      "type": "object",
      "properties": {
        "time": {
          "type": "string",
          "minLength": 1
        },
        "space": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "time",
        "space"
      ],
      "additionalProperties": false
    },
    "youtube": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "title",
        "description",
        "tags"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "hook",
    "opTexts",
    "outroText",
    "complexity",
    "youtube"
  ],
  "additionalProperties": false
}
